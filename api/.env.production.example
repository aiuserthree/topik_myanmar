# Production API — copy to Railway Variables (never commit real values)
PORT=3000
APP_ENV=production

# Railway PostgreSQL plugin → DATABASE_URL (postgresql://...)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/topik_mm_prod

# Generate: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_prod_access_secret
JWT_REFRESH_SECRET=CHANGE_ME_prod_refresh_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# FO origin(s) — comma-separated, no wildcard
CORS_ORIGINS=https://topik-myanmar.vercel.app

# Optional — after custom domain
# CORS_ORIGINS=https://topik-myanmar.vercel.app,https://www.topik-mm.example

# Public FO origin used to build links inside emails (password reset)
PUBLIC_FO_BASE=https://topik-myanmar.vercel.app

# Google Sign-In (Google Identity Services). Leave BLANK to keep the button hidden.
# Create an OAuth client ID (type: Web application) in Google Cloud Console and add
# every production FO origin to "Authorized JavaScript origins"
# (e.g. https://topik-myanmar.vercel.app). The GIS ID-token flow needs no redirect URI.
GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=CHANGE_ME_google_client_secret

# Mailer — REQUIRED for real verification-code / password-reset emails to send.
# Easiest: Resend (https://resend.com) — verify a sending domain, paste the API key.
MAIL_PROVIDER=resend
MAIL_FROM=TOPIK Myanmar <no-reply@your-verified-domain>
RESEND_API_KEY=CHANGE_ME_re_xxx
# --- OR classic SMTP instead of Resend ---
# MAIL_PROVIDER=smtp
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=CHANGE_ME
# SMTP_PASS=CHANGE_ME
